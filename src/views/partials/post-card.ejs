<article class="post-card scanlines">
  <header class="post-card__header">
    <% if (post.categories && post.categories.length) { %>
    <p class="post-card__cats">
      <% post.categories.forEach(function (cat) { %>
      <a href="<%= paths.category(cat.slug) %>"><%= cat.name %></a>
      <% }) %>
    </p>
    <% } %>
    <h2 class="post-card__title">
      <a href="<%= post.url %>"><%= post.title %></a>
    </h2>
    <p class="post-card__meta">
      <% if (post.publishedLabel) { %><time datetime="<%= post.publishedAt || post.createdAt %>"><%= post.publishedLabel %></time><% } %>
      <% if (post.author) { %> · <%= post.author.displayName %><% } %>
    </p>
  </header>
  <% if (post.excerpt) { %>
  <p class="post-card__excerpt"><%= post.excerpt %></p>
  <% } %>
  <% if (post.tags && post.tags.length) { %>
  <p class="post-card__tags">
    <% post.tags.forEach(function (tag) { %>
    <a href="<%= paths.tag(tag.slug) %>">#<%= tag.slug %></a>
    <% }) %>
  </p>
  <% } %>
  <p class="post-card__more">
    <a class="btn btn-ghost btn-sm" href="<%= post.url %>">Read</a>
  </p>
</article>
