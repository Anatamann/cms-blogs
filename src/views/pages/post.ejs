<%- include('../partials/header') %>

<article class="wrap post-page">
  <header class="post-page__header">
    <% if (post.categories && post.categories.length) { %>
    <p class="post-card__cats">
      <% post.categories.forEach(function (cat) { %>
      <a href="<%= paths.category(cat.slug) %>"><%= cat.name %></a>
      <% }) %>
    </p>
    <% } %>
    <h1 class="post-page__title"><%= post.title %></h1>
    <p class="post-card__meta">
      <% if (post.workTitle && post.workUrl) { %>
      <a class="post-work-title" href="<%= post.workUrl %>" title="All posts about <%= post.workTitle %>"><%= post.workTitle %></a> ·
      <% } else if (post.workTitle) { %>
      <span class="post-work-title"><%= post.workTitle %></span> ·
      <% } %>
      <% if (post.publishedLabel) { %>
      <time datetime="<%= post.publishedAt || post.createdAt %>"><%= post.publishedLabel %></time>
      <% } %>
      <% if (post.author) { %> · <%= post.author.displayName %><% } %>
      · <span class="view-count" title="Views (once per browser session)"><%= post.viewCount || 0 %> view<%= (post.viewCount || 0) === 1 ? '' : 's' %></span>
    </p>
  </header>

  <div class="layout-with-sidebar post-layout">
    <div class="layout-main">
      <div class="prose scanlines-soft">
        <%- post.bodyHtml %>
      </div>

      <% if (post.tags && post.tags.length) { %>
      <p class="post-card__tags post-page__tags">
        <% post.tags.forEach(function (tag) { %>
        <a class="chip chip-tag" href="<%= paths.tag(tag.slug) %>">#<%= tag.name %></a>
        <% }) %>
      </p>
      <% } %>

      <!-- Reactions -->
      <section id="reactions" class="reactions" aria-labelledby="reactions-heading">
        <h2 id="reactions-heading" class="section-title">How’d it hit?</h2>
        <div class="reactions-row" role="group" aria-label="Post reactions">
          <% reactions.types.forEach(function (r) { %>
          <form method="post" action="<%= paths.postReaction(post.slug) %>" class="reaction-form">
            <input type="hidden" name="type" value="<%= r.type %>" />
            <button
              type="submit"
              class="reaction-btn<%= reactions.mine.indexOf(r.type) !== -1 ? ' is-active' : '' %>"
              aria-pressed="<%= reactions.mine.indexOf(r.type) !== -1 ? 'true' : 'false' %>"
              title="<%= r.label %>"
            >
              <span class="reaction-emoji" aria-hidden="true"><%= r.emoji %></span>
              <span class="reaction-label"><%= r.label %></span>
              <span class="reaction-count"><%= reactions.counts[r.type] || 0 %></span>
            </button>
          </form>
          <% }) %>
        </div>
      </section>

      <!-- Comments -->
      <section id="comments" class="comments" aria-labelledby="comments-heading">
        <h2 id="comments-heading" class="section-title">Couch talk</h2>

        <% if (commentFlash) { %>
        <p class="flash flash-<%= commentFlash.type === 'ok' ? 'ok' : 'error' %>" role="status">
          <%= commentFlash.message %>
        </p>
        <% } %>

        <% if (!comments.length) { %>
        <p class="muted">Quiet on this thread so far — say something (we mod before it goes live).</p>
        <% } else { %>
        <ul class="comment-list">
          <% comments.forEach(function (c) { %>
          <li class="comment-item card scanlines">
            <header class="comment-item__meta">
              <strong class="comment-item__name"><%= c.authorName %></strong>
              <time datetime="<%= c.createdAt %>"><%= c.createdLabel %></time>
            </header>
            <div class="comment-item__body"><%- c.bodyHtml %></div>
          </li>
          <% }) %>
        </ul>
        <% } %>

        <form method="post" action="<%= paths.postComment(post.slug) %>" class="comment-form contact-form">
          <h3 class="comment-form__title">Join the thread</h3>
          <p class="field-hint">We moderate first so the feed stays chill — your take shows up after approval.</p>

          <!-- Honeypot -->
          <div class="hp-field" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="field">
            <label for="comment-name">Name</label>
            <input id="comment-name" name="name" type="text" required maxlength="80" value="<%= commentForm.name %>" />
          </div>
          <div class="field">
            <label for="comment-email">Email <span class="muted">(not published)</span></label>
            <input id="comment-email" name="email" type="email" maxlength="200" value="<%= commentForm.email %>" />
          </div>
          <div class="field">
            <label for="comment-body">Comment</label>
            <textarea id="comment-body" name="body" rows="5" required maxlength="2000"><%= commentForm.body %></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Send for review</button>
        </form>
      </section>

      <% if (related && related.length) { %>
      <section class="related" aria-labelledby="related-heading">
        <h2 id="related-heading" class="section-title">More from the shelf</h2>
        <div class="post-grid post-grid--compact">
          <% related.forEach(function (post) { %>
            <%- include('../partials/post-card', { post: post }) %>
          <% }) %>
        </div>
      </section>
      <% } %>

      <p class="section-more">
        <a class="btn btn-ghost" href="<%= paths.blog() %>">← Back to the catalog</a>
      </p>
    </div>
    <%- include('../partials/sidebar') %>
  </div>
</article>

<%- include('../partials/footer') %>
