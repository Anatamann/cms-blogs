<%- include('../partials/header') %>

<% /* Full-page scroll scrub via WebP frame sequence (smooth) */ %>
<div
  class="home-scroll"
  data-scroll-hero
  data-frame-count="123"
  data-frame-pad="4"
  data-frame-pattern="/videos/hero-frames/frame-{i}.webp"
  data-frame-poster="/videos/hero-poster.webp"
>
  <div class="home-scroll__stage" aria-hidden="true">
    <canvas class="home-scroll__canvas" data-scroll-canvas width="1280" height="720"></canvas>
    <img
      class="home-scroll__poster"
      data-scroll-poster
      src="/videos/hero-poster.webp"
      alt=""
      decoding="async"
    />
    <div class="home-scroll__veil"></div>
    <div class="home-scroll__progress">
      <div class="home-scroll__progress-bar" data-scroll-progress></div>
    </div>
  </div>

  <div class="home-scroll__content" data-scroll-content>
    <section class="home-scroll__intro wrap" aria-labelledby="hero-heading">
      <p class="badge">Scroll experiment · frame sequence</p>
      <h1 id="hero-heading" class="hero-title home-scroll__title">
        Welcome to <span class="neon glitch-hover"><%= siteName %></span>
      </h1>
      <p class="hero-lead home-scroll__lead">
        <%= typeof siteDescription !== 'undefined' ? siteDescription : 'Reviews, news, and fan theories with CRT glow.' %>
      </p>
      <p class="home-scroll__hint" data-scroll-hint>
        <span class="home-scroll__hint-icon" aria-hidden="true">↓</span>
        Scroll — frames scrub with the page
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="<%= paths.blog() %>">Browse Blog</a>
        <a class="btn btn-ghost" href="#latest-posts">Latest posts</a>
      </div>
    </section>

    <div class="wrap layout-with-sidebar home-scroll__main" id="latest-posts">
      <div class="layout-main">
        <div class="home-scroll__panel">
          <h2 class="section-title">Latest posts</h2>
          <% if (!posts || !posts.length) { %>
          <p class="lead">No published posts yet. Seed the database or create content in admin.</p>
          <% } else { %>
          <div class="post-grid">
            <% posts.forEach(function (post) { %>
              <%- include('../partials/post-card', { post: post }) %>
            <% }) %>
          </div>
          <p class="section-more">
            <a class="btn btn-ghost" href="<%= paths.blog() %>">All posts →</a>
          </p>
          <% } %>
        </div>
      </div>
      <aside class="home-scroll__panel home-scroll__panel--side">
        <%- include('../partials/sidebar') %>
      </aside>
    </div>

    <section class="wrap home-scroll__outro home-scroll__panel" aria-label="Continue">
      <h2 class="section-title">Keep exploring</h2>
      <p class="lead">
        This intro is a WebP frame sequence scrubbed by scroll — same idea as parallax, with exact frames instead of video seeks.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="<%= paths.archive() %>">Archive</a>
        <a class="btn btn-ghost" href="<%= paths.search() %>">Search</a>
        <a class="btn btn-ghost" href="<%= paths.about() %>">About</a>
      </div>
    </section>
  </div>
</div>

<%- include('../partials/footer') %>
