<%- include('../partials/header') %>

<div
  class="home-scroll"
  data-scroll-hero
  data-frame-count="123"
  data-frame-pad="4"
  data-frame-pattern="/videos/hero-frames/frame-{i}.webp"
  data-frame-poster="/videos/hero-poster.webp"
>
  <div class="home-scroll__stage" aria-hidden="true">
    <canvas class="home-scroll__canvas" data-scroll-canvas width="1280" height="720"></canvas>
    <img
      class="home-scroll__poster"
      data-scroll-poster
      src="/videos/hero-poster.webp"
      alt=""
      decoding="async"
    />
    <div class="home-scroll__veil"></div>
    <div class="home-scroll__progress">
      <div class="home-scroll__progress-bar" data-scroll-progress></div>
    </div>
  </div>

  <div class="home-scroll__content" data-scroll-content>
    <section class="home-scroll__intro wrap" aria-labelledby="hero-heading">
      <p class="badge">Anime in Me · Millennial shelf · Stay neon</p>
      <h1 id="hero-heading" class="hero-title home-scroll__title">
        Welcome to <span class="neon glitch-hover"><%= siteName %></span>
      </h1>
      <p class="hero-lead home-scroll__lead">
        <%= typeof siteDescription !== 'undefined' ? siteDescription : 'Ainme — Anime in Me. Reviews and deep cuts from Berserk to DBZ, Eva to AoT, drama nights to cultured late-night rewatches.' %>
      </p>
      <p class="home-scroll__hint" data-scroll-hint>
        <span class="home-scroll__hint-icon" aria-hidden="true">↓</span>
        Scroll to enter the grid
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="<%= paths.blog() %>">Dive into the blog</a>
        <a class="btn btn-ghost" href="#latest-posts">Fresh drops</a>
      </div>
    </section>

    <div class="wrap layout-with-sidebar home-scroll__main" id="latest-posts">
      <div class="layout-main">
        <div class="home-scroll__panel">
          <h2 class="section-title">Latest on the feed</h2>
          <% if (!posts || !posts.length) { %>
          <p class="lead">Nothing on the tape yet — check back soon for new reviews and deep cuts.</p>
          <% } else { %>
          <div class="post-grid">
            <% posts.forEach(function (post) { %>
              <%- include('../partials/post-card', { post: post }) %>
            <% }) %>
          </div>
          <p class="section-more">
            <a class="btn btn-ghost" href="<%= paths.blog() %>">Full catalog →</a>
          </p>
          <% } %>
        </div>
      </div>
      <aside class="home-scroll__panel home-scroll__panel--side">
        <%- include('../partials/sidebar') %>
      </aside>
    </div>

    <section class="wrap home-scroll__outro home-scroll__panel" aria-label="More from the site">
      <h2 class="section-title">Still got time on the VHS?</h2>
      <p class="lead">
        Dig the archive, hunt by series, or drop us a line. Same couch, same neon — different decade.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="<%= paths.archive() %>">Archive</a>
        <a class="btn btn-ghost" href="<%= paths.search() %>">Search</a>
        <a class="btn btn-ghost" href="<%= paths.about() %>">About us</a>
      </div>
    </section>
  </div>
</div>

<%- include('../partials/footer') %>
