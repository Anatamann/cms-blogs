<%- include('../partials/header') %>

<section class="hero wrap" aria-labelledby="hero-heading">
  <p class="badge">Anime · Retro · Lightweight</p>
  <h1 id="hero-heading" class="hero-title">Welcome to <span class="neon glitch-hover"><%= siteName %></span></h1>
  <p class="hero-lead">
    <%= typeof siteDescription !== 'undefined' ? siteDescription : 'Reviews, news, and fan theories with CRT glow.' %>
  </p>
  <div class="hero-actions">
    <a class="btn btn-primary" href="<%= paths.blog() %>">Browse Blog</a>
    <a class="btn btn-ghost" href="<%= paths.search() %>">Search</a>
  </div>
</section>

<div class="wrap layout-with-sidebar">
  <div class="layout-main">
    <h2 class="section-title">Latest posts</h2>
    <% if (!posts || !posts.length) { %>
    <p class="lead">No published posts yet. Seed the database or create content in admin (Phase 3).</p>
    <% } else { %>
    <div class="post-grid">
      <% posts.forEach(function (post) { %>
        <%- include('../partials/post-card', { post: post }) %>
      <% }) %>
    </div>
    <p class="section-more">
      <a class="btn btn-ghost" href="<%= paths.blog() %>">All posts →</a>
    </p>
    <% } %>
  </div>
  <%- include('../partials/sidebar') %>
</div>

<%- include('../partials/footer') %>
