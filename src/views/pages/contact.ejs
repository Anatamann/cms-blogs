<%- include('../partials/header') %>

<div class="wrap layout-with-sidebar">
  <div class="layout-main">
    <header class="page-header">
      <h1>Contact</h1>
      <p class="lead">Send a signal. (Messages are acknowledged locally until mail is wired.)</p>
    </header>

    <% if (sent) { %>
    <p class="flash flash-ok" role="status">Thanks — your message was received.</p>
    <% } %>
    <% if (error) { %>
    <p class="flash flash-error" role="alert"><%= error %></p>
    <% } %>

    <form class="contact-form" action="<%= paths.contact() %>" method="post" novalidate>
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" required maxlength="120" value="<%= form.name %>" />
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required maxlength="200" value="<%= form.email %>" />
      </div>
      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="6" required maxlength="5000"><%= form.message %></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Send</button>
    </form>
  </div>
  <%- include('../partials/sidebar') %>
</div>

<%- include('../partials/footer') %>
