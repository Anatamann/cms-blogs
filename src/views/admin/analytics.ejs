<%- include('layout-top') %>

<header class="admin-page-header admin-page-header--row">
  <div>
    <h1>Analytics</h1>
    <p class="lead">
      Lightweight first-party stats — no third-party trackers.
      Post views use the session counter; devices &amp; regions come from request headers on each counted view.
    </p>
  </div>
  <div class="admin-actions">
    <a class="btn btn-ghost<%= days === 7 ? ' is-active' : '' %>" href="<%= paths.admin.analytics() %>?days=7">7d</a>
    <a class="btn btn-ghost<%= days === 30 ? ' is-active' : '' %>" href="<%= paths.admin.analytics() %>?days=30">30d</a>
    <a class="btn btn-ghost<%= days === 90 ? ' is-active' : '' %>" href="<%= paths.admin.analytics() %>?days=90">90d</a>
  </div>
</header>

<div class="admin-stats">
  <div class="stat-card"><span class="stat-n"><%= totals.views %></span><span class="stat-l">Total views (all time)</span></div>
  <div class="stat-card"><span class="stat-n"><%= totals.reactions %></span><span class="stat-l">Total reactions</span></div>
  <div class="stat-card"><span class="stat-n"><%= totals.trackedRecent %></span><span class="stat-l">Tracked hits (<%= days %>d)</span></div>
  <div class="stat-card"><span class="stat-n"><%= totals.trackedEvents %></span><span class="stat-l">Tracked events (stored)</span></div>
</div>

<div class="admin-two-col">
  <section class="card scanlines" style="padding:1rem">
    <h2 class="section-title">Top posts by views</h2>
    <% if (!topPosts.length) { %>
    <p class="muted">No published posts yet.</p>
    <% } else { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Post</th>
          <th>Views</th>
          <th>Reactions</th>
        </tr>
      </thead>
      <tbody>
        <% topPosts.forEach(function (p) { %>
        <tr>
          <td>
            <a href="<%= paths.admin.postEdit(p.id) %>"><%= p.title %></a>
            <br /><span class="muted"><code>/blog/<%= p.slug %></code></span>
          </td>
          <td><strong><%= p.viewCount || 0 %></strong></td>
          <td class="muted"><%= p.reactions || 0 %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </section>

  <section class="card scanlines" style="padding:1rem">
    <h2 class="section-title">Top posts by reactions</h2>
    <% if (!topByReactions.length) { %>
    <p class="muted">No reactions yet — they appear when readers use 👍 🔥 💜 😮 on posts.</p>
    <% } else { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Post</th>
          <th>Reactions</th>
          <th>Views</th>
        </tr>
      </thead>
      <tbody>
        <% topByReactions.forEach(function (p) { %>
        <tr>
          <td><a href="<%= paths.admin.postEdit(p.id) %>"><%= p.title %></a></td>
          <td><strong><%= p.reactions %></strong></td>
          <td class="muted"><%= p.viewCount || 0 %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>

    <h3 class="section-title" style="margin-top:1.25rem">Reactions by type</h3>
    <% if (!reactionByType.length) { %>
    <p class="muted">—</p>
    <% } else { %>
    <ul class="admin-list">
      <% reactionByType.forEach(function (r) { %>
      <li><strong><%= r.type %></strong> <span class="muted"><%= r.total %></span></li>
      <% }) %>
    </ul>
    <% } %>
  </section>
</div>

<div class="admin-two-col" style="margin-top:1.25rem">
  <section class="card scanlines" style="padding:1rem">
    <h2 class="section-title">Devices (last <%= days %>d)</h2>
    <% if (!devices.length) { %>
    <p class="muted">No tracked pageviews in this window yet. Open a few posts in a normal browser session to seed data.</p>
    <% } else { %>
    <table class="admin-table">
      <thead>
        <tr><th>Device</th><th>Hits</th><th></th></tr>
      </thead>
      <tbody>
        <%
          var deviceSum = devices.reduce(function (a, d) { return a + (d.total || 0); }, 0) || 1;
          devices.forEach(function (d) {
            var pct = Math.round((d.total / deviceSum) * 100);
        %>
        <tr>
          <td><%= d.device %></td>
          <td><strong><%= d.total %></strong></td>
          <td class="muted" style="min-width:8rem">
            <div class="analytics-bar" style="--pct:<%= pct %>%" title="<%= pct %>%"></div>
            <%= pct %>%
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </section>

  <section class="card scanlines" style="padding:1rem">
    <h2 class="section-title">Regions (last <%= days %>d)</h2>
    <p class="muted field-hint">
      Country from CDN headers when present (<code>CF-IPCountry</code>, etc.).
      Otherwise <code>XX</code> or Accept-Language region. No geo-IP database ships with Ainme.
    </p>
    <% if (!regions.length) { %>
    <p class="muted">No region data yet.</p>
    <% } else { %>
    <table class="admin-table">
      <thead>
        <tr><th>Region</th><th>Hits</th></tr>
      </thead>
      <tbody>
        <% regions.forEach(function (r) { %>
        <tr>
          <td><code><%= r.region %></code><% if (r.region === 'XX') { %> <span class="muted">unknown</span><% } %></td>
          <td><strong><%= r.total %></strong></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </section>
</div>

<% if (daily && daily.length) { %>
<section class="card scanlines" style="padding:1rem;margin-top:1.25rem">
  <h2 class="section-title">Daily tracked hits (last <%= days %>d)</h2>
  <table class="admin-table">
    <thead>
      <tr><th>Day</th><th>Hits</th></tr>
    </thead>
    <tbody>
      <% daily.forEach(function (d) { %>
      <tr>
        <td><%= d.day %></td>
        <td><strong><%= d.total %></strong></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<% } %>

<section class="card admin-taxonomy-help" style="margin-top:1.5rem">
  <h2 class="section-title">How this stays light</h2>
  <ul class="muted">
    <li><strong>Views</strong> — integer on each post; +1 once per browser session (same as the public view counter).</li>
    <li><strong>Reactions</strong> — live rows from the reactions table (👍 🔥 💜 😮).</li>
    <li><strong>Devices / regions</strong> — stored on counted pageviews only; soft-capped (~50k events).</li>
    <li>No Google Analytics / no external scripts on the public site.</li>
  </ul>
</section>

<%- include('layout-bottom') %>
