<%- include('layout-top') %>

<% var ret = typeof returnTo !== 'undefined' && returnTo ? returnTo : ''; %>

<header class="admin-page-header admin-page-header--row">
  <div>
    <h1>Media library</h1>
    <p class="lead"><%= pagination.total %> file<%= pagination.total === 1 ? '' : 's' %> · images → WebP · GIF animation preserved · video ≤ 30MB</p>
  </div>
  <% if (ret) { %>
  <div class="admin-actions">
    <a class="btn btn-primary" href="<%= ret %>">← Back to post editor</a>
  </div>
  <% } %>
</header>

<% if (ret) { %>
<p class="flash flash-ok" role="status">
  Your post draft is saved temporarily. Upload a file, then you’ll return to the editor — or use
  <a href="<%= ret %>"><strong>Back to post editor</strong></a> anytime.
</p>
<% } %>

<section class="card media-upload-panel">
  <h2 class="section-title">Upload</h2>
  <form
    method="post"
    action="<%= paths.admin.mediaUpload() %>"
    enctype="multipart/form-data"
    class="admin-form media-upload-form"
  >
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="type" value="<%= typeFilter %>" />
    <% if (ret) { %><input type="hidden" name="returnTo" value="<%= ret %>" /><% } %>
    <div class="field">
      <label for="files">Files</label>
      <input
        id="files"
        name="files"
        type="file"
        required
        multiple
        accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,video/quicktime,.jpg,.jpeg,.png,.webp,.gif,.mp4,.webm,.mov"
      />
      <p class="field-hint">
        Multi-select up to <strong>12 files</strong>, <strong>30MB total</strong> per upload.
        JPEG/PNG/WebP → WebP + thumb. GIF keeps animation. Video max 30MB each.
      </p>
    </div>
    <div class="field">
      <label for="alt">Alt / description</label>
      <input id="alt" name="alt" type="text" maxlength="300" placeholder="Optional alt (applied to all in this batch)" />
    </div>
    <button type="submit" class="btn btn-primary"><%= ret ? 'Upload & return to post' : 'Upload' %></button>
  </form>
</section>

<div class="admin-filters" style="margin-top:1.25rem">
  <a class="chip <%= typeFilter === 'all' ? 'is-active' : '' %>" href="<%= withReturnTo(paths.admin.media() + '?type=all', ret || null) %>">All</a>
  <a class="chip <%= typeFilter === 'image' ? 'is-active' : '' %>" href="<%= withReturnTo(paths.admin.media() + '?type=image', ret || null) %>">Images</a>
  <a class="chip <%= typeFilter === 'gif' ? 'is-active' : '' %>" href="<%= withReturnTo(paths.admin.media() + '?type=gif', ret || null) %>">GIFs</a>
  <a class="chip <%= typeFilter === 'video' ? 'is-active' : '' %>" href="<%= withReturnTo(paths.admin.media() + '?type=video', ret || null) %>">Videos</a>
</div>

<% if (!items.length) { %>
<p class="muted">No media yet. Upload something above.</p>
<% } else { %>
<div class="media-grid">
  <% items.forEach(function (item) { %>
  <article class="media-card card">
    <div class="media-card__preview">
      <% if (item.type === 'video') { %>
        <% if (item.thumbUrl) { %>
        <img src="<%= item.thumbUrl %>" alt="<%= item.alt || item.filename %>" loading="lazy" />
        <% } else { %>
        <div class="media-card__video-ph">VIDEO</div>
        <% } %>
      <% } else { %>
      <img src="<%= item.thumbUrl || item.url %>" alt="<%= item.alt || item.filename %>" loading="lazy" />
      <% } %>
      <span class="status-pill media-type-pill"><%= item.type %></span>
    </div>
    <div class="media-card__body">
      <p class="media-card__name" title="<%= item.filename %>"><%= item.filename %></p>
      <p class="muted media-card__meta"><%= item.sizeLabel %><% if (item.width) { %> · <%= item.width %>×<%= item.height %><% } %></p>
      <p class="media-card__path"><code><%= item.url %></code></p>
      <div class="media-card__actions">
        <button type="button" class="btn btn-ghost btn-sm" data-copy="<%= item.url %>">Copy URL</button>
        <button type="button" class="btn btn-ghost btn-sm" data-copy="<%= item.markdown.trim() %>">Copy MD</button>
        <a class="btn btn-ghost btn-sm" href="<%= item.url %>" target="_blank" rel="noopener">Open</a>
        <% if (ret) { %>
        <a class="btn btn-primary btn-sm" href="<%= ret %>">Use in post</a>
        <% } %>
      </div>
      <form method="post" action="<%= paths.admin.mediaAlt(item.id) %>" class="media-alt-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="type" value="<%= typeFilter %>" />
        <% if (ret) { %><input type="hidden" name="returnTo" value="<%= ret %>" /><% } %>
        <label class="sr-only" for="alt-<%= item.id %>">Alt text</label>
        <input id="alt-<%= item.id %>" name="alt" type="text" value="<%= item.alt %>" placeholder="Alt text" maxlength="300" />
        <button type="submit" class="btn btn-ghost btn-sm">Save alt</button>
      </form>
      <form method="post" action="<%= paths.admin.mediaDelete(item.id) %>" onsubmit="return confirm('Delete this media file?');">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="type" value="<%= typeFilter %>" />
        <% if (ret) { %><input type="hidden" name="returnTo" value="<%= ret %>" /><% } %>
        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
      </form>
    </div>
  </article>
  <% }) %>
</div>

<% if (pagination.totalPages > 1) { %>
<nav class="pagination" aria-label="Media pagination">
  <% if (pagination.page > 1) { %>
  <a class="btn btn-ghost btn-sm" href="<%= withReturnTo(paths.admin.media() + '?type=' + typeFilter + '&page=' + (pagination.page - 1), ret || null) %>">← Prev</a>
  <% } %>
  <span class="pagination__status">Page <%= pagination.page %> / <%= pagination.totalPages %></span>
  <% if (pagination.page < pagination.totalPages) { %>
  <a class="btn btn-ghost btn-sm" href="<%= withReturnTo(paths.admin.media() + '?type=' + typeFilter + '&page=' + (pagination.page + 1), ret || null) %>">Next →</a>
  <% } %>
</nav>
<% } %>
<% } %>

<% if (ret) { %>
<p style="margin-top:1.5rem">
  <a class="btn btn-primary" href="<%= ret %>">← Back to post editor</a>
</p>
<% } %>

<%- include('layout-bottom') %>
