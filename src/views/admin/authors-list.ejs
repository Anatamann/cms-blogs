<%- include('layout-top') %>

<header class="admin-page-header admin-page-header--row">
  <div>
    <h1>Authors</h1>
    <p class="lead">
      Super-admin controls. Super-admins are set in
      <code>SUPER_ADMIN_USERNAMES</code> (currently:
      <% superAdminUsernames.forEach(function (u, i) { %><code>@<%= u %></code><% if (i < superAdminUsernames.length - 1) { %>, <% } %><% }) %>).
    </p>
  </div>
  <div class="admin-actions">
    <a class="btn btn-primary" href="<%= paths.admin.authorNew() %>">New author</a>
  </div>
</header>

<table class="admin-table">
  <thead>
    <tr>
      <th>Display name</th>
      <th>Login</th>
      <th>Posts</th>
      <th>Role</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% authors.forEach(function (a) { %>
    <tr>
      <td>
        <strong><%= a.displayName %></strong>
        <% if (a.bio) { %><br /><span class="muted admin-tag-desc"><%= a.bio.slice(0, 80) %><%= a.bio.length > 80 ? '…' : '' %></span><% } %>
      </td>
      <td><code>@<%= a.username %></code></td>
      <td class="muted"><%= a.postCount || 0 %></td>
      <td>
        <% if (a.isSuperAdmin) { %>
        <span class="chip">Super admin</span>
        <% } else { %>
        <span class="muted">Author</span>
        <% } %>
      </td>
      <td class="admin-row-actions">
        <a href="<%= paths.admin.authorEdit(a.id) %>">Edit</a>
        <% if (!a.isSuperAdmin) { %>
        ·
        <form
          method="post"
          action="<%= paths.admin.authorDelete(a.id) %>"
          style="display:inline"
          onsubmit="return confirm('Delete author @<%= a.username %>? Only allowed if they have 0 posts.');"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="linkish-danger">Delete</button>
        </form>
        <% } %>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>

<section class="card admin-taxonomy-help" style="margin-top:1.5rem">
  <h2 class="section-title">How super-admin works</h2>
  <ul class="muted">
    <li>Add or remove super-admins in <code>.env</code>: <code>SUPER_ADMIN_USERNAMES=octopus</code> (comma-separated for more).</li>
    <li>Restart the app after changing <code>.env</code> so config reloads.</li>
    <li>Regular authors can still write posts and edit their own profile under Settings.</li>
    <li>Delete only works when the author has no posts (reassign/delete posts first).</li>
  </ul>
</section>

<%- include('layout-bottom') %>
