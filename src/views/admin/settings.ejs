<%- include('layout-top') %>

<header class="admin-page-header">
  <h1>Settings</h1>
  <p class="lead">
    Site identity and your profile.
    <% if (isSuperAdmin) { %>
    Super-admins manage all authors under
    <a href="<%= paths.admin.authors() %>">Authors</a>.
    <% } %>
  </p>
</header>

<% if (error) { %>
<p class="flash flash-error" role="alert"><%= error %></p>
<% } %>

<form method="post" action="<%= paths.admin.settings() %>" class="admin-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

  <fieldset class="field">
    <legend>Site</legend>
    <div class="field">
      <label for="site_title">Site title</label>
      <input id="site_title" name="site_title" type="text" required value="<%= settings.site_title %>" />
    </div>
    <div class="field">
      <label for="site_description">Description</label>
      <textarea id="site_description" name="site_description" rows="3"><%= settings.site_description %></textarea>
    </div>
    <div class="field">
      <label for="posts_per_page">Posts per page</label>
      <input id="posts_per_page" name="posts_per_page" type="number" min="1" max="50" value="<%= settings.posts_per_page %>" />
    </div>
  </fieldset>

  <% if (me) { %>
  <fieldset class="field">
    <legend>Your profile (@<%= me.username %>)</legend>
    <div class="field">
      <label for="displayName">Display name</label>
      <input id="displayName" name="displayName" type="text" required maxlength="120" value="<%= me.displayName %>" />
    </div>
    <div class="field">
      <label for="bio">Bio</label>
      <textarea id="bio" name="bio" rows="3" maxlength="2000"><%= me.bio || '' %></textarea>
    </div>
    <p class="field-hint">
      <% if (isSuperAdmin) { %>
      To set passwords or create authors, use <a href="<%= paths.admin.authors() %>">Authors</a>.
      <% } else { %>
      Ask a super-admin to reset your password if needed.
      <% } %>
    </p>
  </fieldset>
  <% } %>

  <button type="submit" class="btn btn-primary">Save settings</button>
</form>

<%- include('layout-bottom') %>
