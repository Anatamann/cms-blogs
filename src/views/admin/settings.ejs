<%- include('layout-top') %>

<header class="admin-page-header">
  <h1>Settings</h1>
  <p class="lead">Site identity and author bios.</p>
</header>

<% if (error) { %>
<p class="flash flash-error" role="alert"><%= error %></p>
<% } %>

<form method="post" action="<%= paths.admin.settings() %>" class="admin-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

  <fieldset class="field">
    <legend>Site</legend>
    <div class="field">
      <label for="site_title">Site title</label>
      <input id="site_title" name="site_title" type="text" required value="<%= settings.site_title %>" />
    </div>
    <div class="field">
      <label for="site_description">Description</label>
      <textarea id="site_description" name="site_description" rows="3"><%= settings.site_description %></textarea>
    </div>
    <div class="field">
      <label for="posts_per_page">Posts per page</label>
      <input id="posts_per_page" name="posts_per_page" type="number" min="1" max="50" value="<%= settings.posts_per_page %>" />
    </div>
  </fieldset>

  <fieldset class="field">
    <legend>Authors</legend>
    <% authors.forEach(function (author) { %>
    <div class="author-edit card">
      <input type="hidden" name="authorId" value="<%= author.id %>" />
      <p class="muted">@<%= author.username %> · <code><%= author.id %></code></p>
      <div class="field">
        <label for="displayName_<%= author.id %>">Display name</label>
        <input id="displayName_<%= author.id %>" name="displayName_<%= author.id %>" type="text" value="<%= author.displayName %>" />
      </div>
      <div class="field">
        <label for="bio_<%= author.id %>">Bio</label>
        <textarea id="bio_<%= author.id %>" name="bio_<%= author.id %>" rows="2"><%= author.bio || '' %></textarea>
      </div>
    </div>
    <% }) %>
  </fieldset>

  <button type="submit" class="btn btn-primary">Save settings</button>
</form>

<%- include('layout-bottom') %>
