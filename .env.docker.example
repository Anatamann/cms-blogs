# Template only — copy to .env and fill in privately.
#   cp .env.docker.example .env
# NEVER commit real .env (it is gitignored). Do not put real passwords here.

NODE_ENV=production
SITE_NAME=Ainme

# Public origin browsers use (feeds, OG, cookie Secure when https://)
APP_URL=http://localhost:8080

# REQUIRED — generate: openssl rand -hex 32
SESSION_SECRET=

# Super-admin CMS usernames (comma-separated). No passwords here.
# Example: SUPER_ADMIN_USERNAMES=myadmin
SUPER_ADMIN_USERNAMES=

# Optional cookie override (default follows APP_URL scheme)
# COOKIE_SECURE=false

# Seed on boot (idempotent). Passwords belong only in your private .env
AUTO_SEED=true
SEED_ADMIN_PASSWORD=
# SEED_GOKUN_PASSWORD=
# SEED_RESET_OCTOPUS_PASSWORD=true

NGINX_HTTP_PORT=8080

RATE_LIMIT_LOGIN=20
RATE_LIMIT_CONTACT=15
RATE_LIMIT_WRITE=120

COMPRESS_VIDEO=false
