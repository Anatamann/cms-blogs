# Copy to .env for Docker Compose production deploy:
#   cp .env.docker.example .env
#   # then edit secrets and APP_URL

NODE_ENV=production
SITE_NAME=Ainme
# Public origin as browsers see it (feeds, OG, redirects)
APP_URL=http://localhost:8080

# REQUIRED — generate with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-openssl-rand-hex-32-output

# Ensure catalog posts (test blogs + tags + work titles) on boot — safe to leave true
AUTO_SEED=true
SEED_ADMIN_PASSWORD=changeme
# Optional: password for gokun (default Gokun)
# SEED_GOKUN_PASSWORD=Gokun

# Host port for Nginx
NGINX_HTTP_PORT=8080

# Optional rate limits
RATE_LIMIT_LOGIN=20
RATE_LIMIT_CONTACT=15
RATE_LIMIT_WRITE=120

# Media
COMPRESS_VIDEO=false
