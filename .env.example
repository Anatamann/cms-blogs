# Template only — copy to .env and fill in privately.
#   cp .env.example .env
# NEVER commit real .env (gitignored). Do not store real passwords in this file.

# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SITE_NAME=Ainme

# Security — REQUIRED strong value in production
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Super-admin CMS usernames only (comma-separated). Not passwords.
# Example: SUPER_ADMIN_USERNAMES=myadmin
SUPER_ADMIN_USERNAMES=

# Session cookies: unset = follow APP_URL (Secure only when https://)
# COOKIE_SECURE=true
# COOKIE_SECURE=false

# Rate limits (optional)
RATE_LIMIT_LOGIN=20
RATE_LIMIT_CONTACT=15
RATE_LIMIT_WRITE=120

# Paths
DATA_DIR=./data
DATABASE_FILE=ainme.sqlite
UPLOADS_DIR=./public/uploads

# Seed (idempotent). Set passwords only in private .env
AUTO_SEED=true
SEED_ADMIN_PASSWORD=
# SEED_GOKUN_PASSWORD=
# SEED_RESET_OCTOPUS_PASSWORD=true

# Media
MAX_VIDEO_BYTES=31457280
MAX_IMAGE_BYTES=15728640
MAX_GIF_BYTES=15728640
MAX_IMAGE_DIMENSION=1920
THUMB_WIDTH=400
IMAGE_QUALITY=80
COMPRESS_VIDEO=false

# Docker host port for Nginx
NGINX_HTTP_PORT=8080
