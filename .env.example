# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SITE_NAME=Ainme Blog

# Security (REQUIRED strong value in production — app refuses weak defaults)
SESSION_SECRET=change-me-to-a-long-random-string

# Rate limits (optional overrides)
RATE_LIMIT_LOGIN=20
RATE_LIMIT_CONTACT=15
RATE_LIMIT_WRITE=120

# Paths (relative to project root unless absolute)
DATA_DIR=./data
DATABASE_FILE=ainme.sqlite
UPLOADS_DIR=./public/uploads

# Seed sample content on first boot (also: npm run db:seed)
AUTO_SEED=true
SEED_ADMIN_PASSWORD=changeme

# Media (Phase 4)
MAX_VIDEO_BYTES=31457280
MAX_IMAGE_BYTES=15728640
MAX_GIF_BYTES=15728640
MAX_IMAGE_DIMENSION=1920
THUMB_WIDTH=400
IMAGE_QUALITY=80
# Set true to re-encode videos with ffmpeg when smaller
COMPRESS_VIDEO=false

# Docker / reverse proxy (used by compose)
NGINX_HTTP_PORT=8080
