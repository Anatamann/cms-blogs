# Dependencies
node_modules/

# Private environment — NEVER commit real secrets
.env
.env.*
!.env.example
!.env.docker.example

# Runtime / data (local SQLite, WAL, test DBs)
data/*
!data/.gitkeep
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# Uploads (keep folder structure only)
public/uploads/images/*
public/uploads/gifs/*
public/uploads/videos/*
!public/uploads/**/.gitkeep

# Large local media (hero frames can be regenerated; omit from public clone noise)
public/videos/
SECURITY.md
# Backups (may contain DB + private content)
backups/
*.tar.gz

# Logs & OS
logs/
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Coverage / build artifacts
coverage/
dist/
tmp/
.cache/
